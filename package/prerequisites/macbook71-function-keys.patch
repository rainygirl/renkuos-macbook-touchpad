index 0000000..7e5a8fe
--- /dev/null
+++ b/src/tests/add-ons/macbook71/test_macbook71.cpp
@@ -0,0 +1,37 @@
+// SPDX-License-Identifier: MIT
+#include <assert.h>
+#include <stdio.h>
+#include <MacBook71Keys.h>
+
+int
+main()
+{
+	for (unsigned key = 2; key <= 13; key++) {
+		for (int fn = 0; fn <= 1; fn++) {
+			MacBook71Keys keys;
+			unsigned expected = fn || key == 6 || key == 7 ? key : kMacBook71KeyBase + key - 1;
+			assert(keys.Translate(key, true, fn) == expected);
+			// A changed Fn state must not change a held key, its repeats or its release.
+			assert(keys.Translate(key, true, !fn) == expected);
+			assert(keys.Translate(key, false, !fn) == expected);
+			// The next press must use the new Fn state.
+			unsigned next = !fn || key == 6 || key == 7 ? key : kMacBook71KeyBase + key - 1;
+			assert(keys.Translate(key, true, !fn) == next);
+			assert(keys.Translate(key, false, fn) == next);
+		}
+	}
+	MacBook71Keys keys;
+	assert(keys.Translate(2, true, false) == kMacBook71KeyBase + 1);
+	assert(keys.Translate(3, true, true) == 3);
+	assert(keys.Translate(2, false, true) == kMacBook71KeyBase + 1);
+	assert(keys.Translate(3, false, false) == 3);
+	for (unsigned key = 0; key < 0x100; key++) {
+		if (key >= 2 && key <= 13)
+			continue;
+		assert(keys.Translate(key, true, false) == key);
+		assert(keys.Translate(key, false, true) == key);
+	}
+	assert(keys.Translate(0xc00e9, true, false) == 0xc00e9);
+	puts("PASS: all F1-F12 mappings, Fn order/repeat/release, simultaneous keys, ordinary/consumer "
+		 "keys");
+}
