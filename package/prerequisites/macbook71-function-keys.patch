diff --git a/src/add-ons/input_server/filters/macbook71/MacBook71InputFilter.cpp b/src/add-ons/input_server/filters/macbook71/MacBook71InputFilter.cpp
new file mode 100644
index 0000000..aa3b515
--- /dev/null
+++ b/src/add-ons/input_server/filters/macbook71/MacBook71InputFilter.cpp
@@ -0,0 +1,168 @@
+// SPDX-License-Identifier: MIT
+
+#include <InputServerFilter.h>
+#include <Entry.h>
+#include <Looper.h>
+#include <Message.h>
+#include <Messenger.h>
+#include <Roster.h>
+#include <OS.h>
+#include <MacBook71Keys.h>
+#include <mcp89_backlight.h>
+
+#include <image.h>
+#include <errno.h>
+#include <fcntl.h>
+#include <new>
+#include <sys/ioctl.h>
+#include <syslog.h>
+#include <unistd.h>
+
+extern char** environ;
+
+class FunctionKeyWorker : public BLooper
+{
+public:
+	FunctionKeyWorker() : BLooper("MacBook7,1 function keys")
+	{
+	}
+
+	void
+	MessageReceived(BMessage* message)
+	{
+		int32 key;
+		if (message->FindInt32("function", &key) != B_OK) {
+			BLooper::MessageReceived(message);
+			return;
+		}
+		// Drop stale repeats rather than replaying them after a slow service.
+		bool repeat = false;
+		bigtime_t when = 0;
+		message->FindBool("repeat", &repeat);
+		message->FindInt64("when", &when);
+		if (repeat && system_time() - when > 250000)
+			return;
+
+		status_t status = B_OK;
+		if (key == 1 || key == 2) {
+			int fd = open(MCP89_BACKLIGHT_DEVICE, O_RDWR);
+			if (fd < 0)
+				status = errno;
+			else {
+				int32 step = key == 1 ? -5 : 5;
+				if (ioctl(fd, MCP89_ADJUST_BRIGHTNESS, &step, sizeof(step)) < 0)
+					status = errno;
+				close(fd);
+			}
+		} else if (key == 3) {
+			status = be_roster->Launch("application/x-vnd.Be-WORK");
+		} else if (key == 4) {
+			entry_ref ref;
+			status = get_ref_for_path("/boot/system/apps", &ref);
+			if (status == B_OK) {
+				BMessage refs(B_REFS_RECEIVED);
+				refs.AddRef("refs", &ref);
+				status = BMessenger("application/x-vnd.Be-TRAK").SendMessage(&refs);
+			}
+		} else if (key >= 7 && key <= 9) {
+			BMessage command(B_EXECUTE_PROPERTY);
+			command.AddSpecifier(key == 7 ? "Prev" : key == 8 ? "TogglePlaying" : "Next");
+			command.AddSpecifier("Window", (int32)0);
+			status = BMessenger("application/x-vnd.Haiku-MediaPlayer")
+						 .SendMessage(&command, (BHandler*)NULL, 100000);
+		} else if (key >= 10 && key <= 12) {
+			const char* args[] = {"/boot/system/bin/setvolume",
+								  key == 10	  ? "-t"
+								  : key == 11 ? "-d"
+											  : "-i",
+								  NULL};
+			thread_id thread = load_image(2, args, (const char**)environ);
+			if (thread < 0)
+				status = thread;
+			else {
+				status = resume_thread(thread);
+				if (status != B_OK)
+					kill_thread(thread);
+				if (status == B_OK) {
+					status_t result;
+					status = wait_for_thread(thread, &result);
+					if (status == B_OK)
+						status = result;
+				}
+			}
+		}
+		if (status != B_OK && status != B_ALREADY_RUNNING && !repeat)
+			syslog(LOG_WARNING, "MacBook7,1: F%" B_PRId32 " action failed: %" B_PRId32, key, status);
+	}
+};
+
+class MacBook71InputFilter : public BInputServerFilter
+{
+public:
+	MacBook71InputFilter() : fWorker(new (std::nothrow) FunctionKeyWorker), fStatus(B_NO_MEMORY)
+	{
+		for (int i = 0; i < 12; i++) {
+			fPressed[i] = false;
+			fLastAction[i] = 0;
+		}
+		if (fWorker != NULL) {
+			thread_id thread = fWorker->Run();
+			fStatus = thread < 0 ? thread : B_OK;
+		}
+	}
+
+	~MacBook71InputFilter()
+	{
+		if (fWorker != NULL && fWorker->Lock())
+			fWorker->Quit();
+	}
+
+	status_t
+	InitCheck()
+	{
+		return fStatus;
+	}
+
+	filter_result
+	Filter(BMessage* message, BList*)
+	{
+		bool down = message->what == B_UNMAPPED_KEY_DOWN;
+		if (!down && message->what != B_UNMAPPED_KEY_UP)
+			return B_DISPATCH_MESSAGE;
+		int32 key;
+		if (message->FindInt32("key", &key) != B_OK || key <= (int32)kMacBook71KeyBase ||
+			key > (int32)kMacBook71KeyBase + 12)
+			return B_DISPATCH_MESSAGE;
+		int32 function = key - kMacBook71KeyBase;
+		if (function == 5 || function == 6 || fStatus != B_OK)
+			return B_DISPATCH_MESSAGE;
+		int32 index = function - 1;
+		bool repeat = fPressed[index];
+		fPressed[index] = down;
+		if (!down)
+			return B_SKIP_MESSAGE;
+		bool repeatable = function == 1 || function == 2 || function == 11 || function == 12;
+		bigtime_t now = system_time();
+		if (repeat && (!repeatable || now - fLastAction[index] < 100000))
+			return B_SKIP_MESSAGE;
+		fLastAction[index] = now;
+		BMessage action('MB71');
+		action.AddInt32("function", function);
+		action.AddBool("repeat", repeat);
+		action.AddInt64("when", now);
+		fWorker->PostMessage(&action);
+		return B_SKIP_MESSAGE;
+	}
+
+private:
+	FunctionKeyWorker* fWorker;
+	status_t fStatus;
+	bool fPressed[12];
+	bigtime_t fLastAction[12];
+};
+
+extern "C" BInputServerFilter*
+instantiate_input_filter()
+{
+	return new (std::nothrow) MacBook71InputFilter;
+}
