+
+#include <Drivers.h>
+
+#define MCP89_BACKLIGHT_DEVICE "/dev/power/mcp89_backlight"
+
+// All operations transfer one int32 percentage. ADJUST returns the new level.
+enum {
+	MCP89_GET_BRIGHTNESS = B_DEVICE_OP_CODES_END + 1,
+	MCP89_SET_BRIGHTNESS,
+	MCP89_ADJUST_BRIGHTNESS
+};
+
+#endif
diff --git a/headers/private/input/MacBook71Keys.h b/headers/private/input/MacBook71Keys.h
new file mode 100644
index 0000000..20966ec
--- /dev/null
+++ b/headers/private/input/MacBook71Keys.h
@@ -0,0 +1,42 @@
+// SPDX-License-Identifier: MIT
+#ifndef _MACBOOK71_KEYS_H
+#define _MACBOOK71_KEYS_H
+
+#include <SupportDefs.h>
+
+// Private raw key codes, emitted only for the built-in MacBook7,1 keyboard.
+// Keep these separate from generic consumer keys and user shortcut bindings.
+static const uint32 kMacBook71KeyBase = 0x0f710000;
+
+class MacBook71Keys
+{
+public:
+	MacBook71Keys()
+	{
+		for (int i = 0; i < 12; i++)
+			fPressed[i] = 0;
+	}
+
+	uint32
+	Translate(uint32 key, bool down, bool fn)
+	{
+		if (key < 2 || key > 13)
+			return key;
+		uint32& pressed = fPressed[key - 2];
+		if (down) {
+			if (pressed == 0) {
+				// F5/F6 have no hardware function on this non-backlit keyboard.
+				pressed = fn || key == 6 || key == 7 ? key : kMacBook71KeyBase + key - 1;
+			}
+			return pressed;
+		}
+		uint32 released = pressed != 0 ? pressed : key;
+		pressed = 0;
+		return released;
+	}
+
+private:
+	uint32 fPressed[12];
+};
+
+#endif
