 		return false;
 
 	bool match = true;
-	if (vendor != NULL && sHardwareVendor != NULL)
-		match = strcmp(vendor, sHardwareVendor) == 0;
-	if (match && product != NULL && sHardwareProduct != NULL)
-		match = strcmp(product, sHardwareProduct) == 0;
+	if (vendor != NULL)
+		match = sHardwareVendor != NULL && strcmp(vendor, sHardwareVendor) == 0;
+	if (match && product != NULL)
+		match = sHardwareProduct != NULL && strcmp(product, sHardwareProduct) == 0;
 	return match;
 }
 
