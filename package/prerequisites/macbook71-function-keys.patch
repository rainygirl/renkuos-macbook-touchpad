index 0000000..f67031b
--- /dev/null
+++ b/src/tests/add-ons/macbook71/run_tests.py
@@ -0,0 +1,110 @@
+#!/usr/bin/env python3
+# SPDX-License-Identifier: MIT
+"""Compile real production logic with minimal host-only type/module stubs."""
+from pathlib import Path
+import subprocess, tempfile, re
+source=Path(__file__).resolve().parents[4]
+root=Path(__file__).resolve().parent
+def function(text,name):
+ start=text.index(name+'(')
+ # Include its static return declaration.
+ start=text.rfind('static ',0,start)
+ brace=text.index('{',start); depth=1;end=brace+1
+ while depth:
+  depth+=(text[end]=='{')-(text[end]=='}');end+=1
+ return text[start:end]
+with tempfile.TemporaryDirectory(prefix='macbook71-tests-') as tmp:
+ t=Path(tmp)
+ (t/'SupportDefs.h').write_text('#include <stdint.h>\ntypedef uint32_t uint32;\n')
+ subprocess.run(['c++','-std=c++11','-Wall','-Wextra','-Werror','-fsanitize=address,undefined','-I'+str(t),'-I'+str(source/'headers/private/input'),str(root/'test_macbook71.cpp'),'-o',str(t/'keys')],check=True)
+ subprocess.run([str(t/'keys')],check=True)
+ text=(source/'src/add-ons/kernel/generic/smbios/smbios.cpp').read_text()
+ body=function(text,'smbios_match_vendor_product')
+ test='''
+#include <cstring>
+#include <cassert>
+#include <cstdio>
+static const char *sHardwareVendor, *sHardwareProduct;
+'''+body+'''
+int main() {
+ const char* vendors[] = {nullptr, "Apple Inc.", "Other"};
+ const char* products[] = {nullptr, "MacBook7,1", "MacBook6,1", "MacBook7,10"};
+ for (auto v: vendors) for (auto p: products) {
+  sHardwareVendor=v; sHardwareProduct=p;
+  assert(smbios_match_vendor_product("Apple Inc.", "MacBook7,1") ==
+   (v && p && !strcmp(v,"Apple Inc.") && !strcmp(p,"MacBook7,1")));
+  assert(!smbios_match_vendor_product(nullptr,nullptr));
+  assert(smbios_match_vendor_product("Apple Inc.",nullptr) == (v && !strcmp(v,"Apple Inc.")));
+  assert(smbios_match_vendor_product(nullptr,"MacBook7,1") == (p && !strcmp(p,"MacBook7,1")));
+ }
+ puts("PASS: exact SMBIOS match, missing firmware strings, wildcard semantics (12 machine identities)");
+}
+'''
+ (t/'smbios.cpp').write_text(test)
+ subprocess.run(['c++','-std=c++11','-Wall','-Wextra','-Werror','-fsanitize=address,undefined',str(t/'smbios.cpp'),'-o',str(t/'smbios')],check=True)
+ subprocess.run([str(t/'smbios')],check=True)
+ # Compile and exercise the actual ioctl function, mocking only kernel services/MMIO.
+ text=(source/'src/add-ons/kernel/drivers/power/mcp89_backlight/mcp89_backlight.cpp').read_text()
+ body=function(text,'backlight_control')
+ test='''
+#include <cstdint>
+#include <cstring>
+#include <cassert>
+#include <cstdio>
+using uint32=uint32_t; using int32=int32_t; using status_t=int;
+#define B_OK 0
+#define B_DEV_INVALID_IOCTL -1
+#define B_BAD_VALUE -2
+#define B_BAD_ADDRESS -3
+#define B_DEV_NOT_READY -4
+#define IS_USER_ADDRESS(p) ((p)!=nullptr)
+enum { MCP89_GET_BRIGHTNESS=1, MCP89_SET_BRIGHTNESS, MCP89_ADJUST_BRIGHTNESS };
+static const uint32 kLevelMask=0xffffff;
+static uint32 storage[64];
+static volatile uint32* sRegisters=storage;
+static int sLock;
+static void mutex_lock(int* l) { assert(*l==0); ++*l; }
+static void mutex_unlock(int* l) { assert(*l==1); --*l; }
+static int user_memcpy(void* to,const void* from,size_t size) { if(!to||!from)return B_BAD_ADDRESS;memcpy(to,from,size);return B_OK; }
+'''+body+'''
+int main() {
+ int32 value=50;
+ assert(backlight_control(nullptr,999,&value,sizeof(value))==B_DEV_INVALID_IOCTL);
+ assert(backlight_control(nullptr,1,nullptr,4)==B_BAD_ADDRESS);
+ assert(backlight_control(nullptr,1,&value,3)==B_BAD_VALUE);
+ for(uint32 period: {2966u,24557u,0xffffffu}) {
+  storage[32]=period;
+  for(int level=0;level<=100;++level) {
+   storage[33]=0x40000000|period;
+   value=level;
+   assert(backlight_control(nullptr,2,&value,4)==B_OK);
+   assert(storage[32]==period);
+   assert(storage[33]==(0x80000000|((period*level+50)/100)));
+   value=-1;
+   assert(backlight_control(nullptr,1,&value,4)==B_OK);
+   assert(value==level);
+  }
+  value=5; assert(backlight_control(nullptr,3,&value,4)==B_OK && value==100);
+  storage[33]=0;value=-5;
+  assert(backlight_control(nullptr,3,&value,4)==B_OK && value==5);
+ }
+ for(int level: {-101,-1,101}) {
+  value=level;uint32 before=storage[33];
+  assert(backlight_control(nullptr,2,&value,4)==B_BAD_VALUE && storage[33]==before);
+ }
+ for(uint32 period: {0u,0xffffffffu}) {
+  storage[32]=period;storage[33]=0;
+  value=50;assert(backlight_control(nullptr,2,&value,4)==B_DEV_NOT_READY);
+  assert(storage[33]==0);
+ }
+ storage[32]=100;storage[33]=101;value=50;
+ assert(backlight_control(nullptr,2,&value,4)==B_DEV_NOT_READY);
+ assert(sLock==0);
+ puts("PASS: native ioctl bounds, latch writes, period preservation, unavailable PWM and integer overflow boundaries");
+}
+'''
+ test=test.replace('#include <cstdio>','#include <cstdio>\n#include <initializer_list>')
+ (t/'pwm.cpp').write_text(test)
+ subprocess.run(['c++','-std=c++11','-Wall','-Wextra','-Werror','-fsanitize=address,undefined',str(t/'pwm.cpp'),'-o',str(t/'pwm')],check=True)
+ subprocess.run([str(t/'pwm')],check=True)
+print('Host logic tests passed. These do not replace a Haiku build or physical keyboard/panel tests.')
diff --git a/src/tests/add-ons/macbook71/test_macbook71.cpp b/src/tests/add-ons/macbook71/test_macbook71.cpp
