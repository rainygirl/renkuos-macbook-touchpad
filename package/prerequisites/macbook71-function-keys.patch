+// SPDX-License-Identifier: MIT
+// Native RenkuOS implementation. Register addresses and latch semantics were
+// measured on this machine by macbook-mint-nvidia-revival (f438b4e0caf7).
+// No Linux driver code is imported; see docs/hardware/macbook71-function-keys.md.
+
+#include <KernelExport.h>
+#include <PCI.h>
+#include <lock.h>
+#include <vm/vm.h>
+#include <smbios.h>
+#include <mcp89_backlight.h>
+
+#include <string.h>
+
+static const uint32 kPWMPage = 0x61c000;
+static const uint32 kLevelMask = 0x00ffffff;
+static const char* sNames[] = {"power/mcp89_backlight", NULL};
+static area_id sArea = -1;
+static volatile uint32* sRegisters;
+static mutex sLock;
+
+int32 api_version = B_CUR_DRIVER_API_VERSION;
+
+extern "C" status_t
+init_hardware()
+{
+	return B_OK;
+}
+
+extern "C" status_t
+init_driver()
+{
+	smbios_module_info* smbios;
+	status_t status = get_module(SMBIOS_MODULE_NAME, (module_info**)&smbios);
+	if (status != B_OK)
+		return status;
+	bool matches = smbios->match_vendor_product("Apple Inc.", "MacBook7,1");
+	put_module(SMBIOS_MODULE_NAME);
+	if (!matches)
+		return B_NOT_SUPPORTED;
+
+	pci_module_info* pci;
+	status = get_module(B_PCI_MODULE_NAME, (module_info**)&pci);
+	if (status != B_OK)
+		return status;
+	pci_info info;
+	bool found = false;
+	for (int32 index = 0; pci->get_nth_pci_info(index, &info) == B_OK; index++) {
+		if (info.vendor_id == 0x10de && info.device_id == 0x08a0 && info.class_base == 3 &&
+			info.class_sub == 0 && (info.u.h0.base_register_flags[0] & 1) == 0 &&
+			info.u.h0.base_registers[0] != 0 &&
+			info.u.h0.base_register_sizes[0] >= kPWMPage + B_PAGE_SIZE &&
+			(pci->read_pci_config(info.bus, info.device, info.function, PCI_command, 2) &
+			 PCI_command_memory) != 0) {
+			found = true;
+			break;
+		}
+	}
+	put_module(B_PCI_MODULE_NAME);
+	if (!found)
+		return B_ENTRY_NOT_FOUND;
+
+	void* address;
+	area_id bootArea =
+		map_physical_memory("MCP89 identity", info.u.h0.base_registers[0], B_PAGE_SIZE,
+							B_ANY_KERNEL_ADDRESS, B_KERNEL_READ_AREA, &address);
+	if (bootArea < 0)
+		return bootArea;
+	uint32 identity = *(volatile uint32*)address;
+	delete_area(bootArea);
+	if (identity == 0xffffffff || ((identity >> 20) & 0x1ff) != 0xaf)
+		return B_NOT_SUPPORTED;
+
+	sArea = map_physical_memory(
+		"MCP89 backlight", (phys_addr_t)info.u.h0.base_registers[0] + kPWMPage, B_PAGE_SIZE,
+		B_ANY_KERNEL_ADDRESS, B_KERNEL_READ_AREA | B_KERNEL_WRITE_AREA, &address);
+	if (sArea < 0)
+		return sArea;
+	sRegisters = (volatile uint32*)address;
+	uint32 period = sRegisters[0x80 / 4];
+	uint32 duty = sRegisters[0x84 / 4];
+	if (period == 0xffffffff || duty == 0xffffffff || (period & kLevelMask) == 0 ||
+		(duty & kLevelMask) > (period & kLevelMask)) {
+		delete_area(sArea);
+		sArea = -1;
+		return B_NOT_SUPPORTED;
+	}
+	mutex_init(&sLock, "MCP89 backlight");
+	// Probe never changes the firmware's panel state or PWM period.
+	return B_OK;
+}
+
+extern "C" void
+uninit_driver()
+{
+	delete_area(sArea);
+	sArea = -1;
+	mutex_destroy(&sLock);
+}
+
+static status_t
+backlight_open(const char*, uint32, void** cookie)
+{
+	*cookie = NULL;
+	return B_OK;
+}
+
+static status_t
+backlight_close(void*)
+{
+	return B_OK;
+}
+
+static status_t
+backlight_control(void*, uint32 op, void* buffer, size_t size)
+{
+	if (op != MCP89_GET_BRIGHTNESS && op != MCP89_SET_BRIGHTNESS && op != MCP89_ADJUST_BRIGHTNESS)
+		return B_DEV_INVALID_IOCTL;
+	if (size != sizeof(int32))
+		return B_BAD_VALUE;
+	if (!IS_USER_ADDRESS(buffer))
+		return B_BAD_ADDRESS;
+	int32 level = 0;
+	if (op != MCP89_GET_BRIGHTNESS) {
+		if (user_memcpy(&level, buffer, sizeof(level)) != B_OK)
+			return B_BAD_ADDRESS;
+		if ((op == MCP89_SET_BRIGHTNESS && (level < 0 || level > 100)) ||
+			(op == MCP89_ADJUST_BRIGHTNESS && (level < -100 || level > 100)))
+			return B_BAD_VALUE;
+	}
+	mutex_lock(&sLock);
+	uint32 rawPeriod = sRegisters[0x80 / 4];
+	uint32 rawDuty = sRegisters[0x84 / 4];
+	uint32 period = rawPeriod & kLevelMask;
+	uint32 duty = rawDuty & kLevelMask;
+	if (rawPeriod == 0xffffffff || rawDuty == 0xffffffff || period == 0 || duty > period) {
+		mutex_unlock(&sLock);
+		return B_DEV_NOT_READY;
+	}
+	int32 current = (duty * 100 + period / 2) / period;
+	if (op == MCP89_GET_BRIGHTNESS)
+		level = current;
+	else {
+		if (op == MCP89_ADJUST_BRIGHTNESS) {
+			level += current;
+			// Hotkeys keep a visible minimum; explicit SET can turn it off.
+			if (level < 5)
+				level = 5;
+			if (level > 100)
+				level = 100;
+		}
+		uint32 value = (period * (uint32)level + 50) / 100;
+		// Bit 31 is a write latch, not a bit to preserve from a read.
+		sRegisters[0x84 / 4] = 0x80000000 | value;
+		(void)sRegisters[0x84 / 4]; // Complete the posted PCI write.
+	}
+	mutex_unlock(&sLock);
+	return user_memcpy(buffer, &level, sizeof(level));
+}
+
+static status_t
+backlight_read(void*, off_t, void*, size_t* size)
+{
+	*size = 0;
+	return B_NOT_ALLOWED;
+}
+
+static status_t
+backlight_write(void*, off_t, const void*, size_t* size)
+{
+	*size = 0;
+	return B_NOT_ALLOWED;
+}
+
+static device_hooks sHooks = {backlight_open,
+							  backlight_close,
+							  backlight_close,
+							  backlight_control,
+							  backlight_read,
+							  backlight_write,
+							  NULL,
+							  NULL,
+							  NULL,
+							  NULL};
+
+extern "C" const char**
+publish_devices()
+{
+	return sNames;
+}
+
+extern "C" device_hooks*
+find_device(const char* name)
+{
+	return strcmp(name, sNames[0]) == 0 ? &sHooks : NULL;
+}
